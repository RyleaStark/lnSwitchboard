# lnSwitchboard local development defaults

SERVICE_PORT=22121
PUBLIC_SERVICE_PORT=21212
# These also configure native listener binds; Compose uses them for host-side publishing.
LNSWITCHBOARD_BIND_ADDRESS=127.0.0.1
LNSWITCHBOARD_PUBLIC_BIND_ADDRESS=127.0.0.1
TRUSTED_PROXY_CIDRS=
TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
ALLOW_PRIVATE_NOSTR_RELAYS=false
ALLOW_PRIVATE_WEBHOOKS=false
LND_HOST=umbrel.local
LND_GRPC_PORT=10009
LND_TLS_PATH=secrets/tls.cert
MIN_SENDABLE_SAT=1
LNURL_METADATA_DESCRIPTION=Pay
LNURL_COMMENT_MAX_LENGTH=280
LNURL_METADATA_LONG_DESC=""
LNURL_PAYER_DATA=""
LNURL_SUCCESS_MESSAGE="Your payment hit faster than a Lightning bolt — {ln_address} stacked your sats!"
RECENT_LOG_LIMIT=50
DATA_STORE_PATH=secrets/lnswitchboard.db
CONNECTION_SECRET_KEY_PATH=secrets/connection-secrets.key
# Enabled by deployment stacks that include the cloudflared connector service.
CLOUDFLARED_CONNECTOR_ENABLED=false
CLOUDFLARED_TOKEN_PATH=secrets/cloudflared/tunnel.token
CLOUDFLARED_METRICS_URL=http://cloudflared:2000
CLOUDFLARED_ORIGIN_URL=http://lnswitchboard:21212
CLOUDFLARED_TOKEN_GID=0
RATE_LIMIT_PER_MIN=30
UI_POLL_SECONDS=10
MACAROON_STORE_PATH=secrets/macaroon.hex
LOG_RETENTION_DAYS=180
